{
  "name": "devtrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "deploy": "npm run build && wrangler deploy --config apps/api/wrangler.toml --env=",
    "dev:api": "wrangler dev --config apps/api/wrangler.toml --env local --ip 127.0.0.1 --port 8787",
    "dev:api:test": "wrangler dev --config apps/api/wrangler.toml --env test --ip 127.0.0.1 --port 8788",
    "dev:web:test": "vite --config apps/web/vite.config.ts --mode e2e --port 5174 --strictPort",
    "db:migrate:test": "wrangler d1 migrations apply devtrack-test --local --config apps/api/wrangler.toml --env test",
    "build": "npm run content:validate && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:java": "tsx scripts/check-java.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "wrangler d1 migrations apply devtrack --local --config apps/api/wrangler.toml --env local",
    "db:seed": "tsx scripts/seed-d1.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:links": "tsx scripts/verify-links.ts",
    "content:prep-links": "tsx scripts/verify-prep-links.ts",
    "api:check": "wrangler deploy --dry-run --config apps/api/wrangler.toml",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run api:check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
